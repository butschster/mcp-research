# mcp-research configuration
transport: sse       # sse for Docker (stdio for local MCP clients)
mcp_port: 8081       # MCP SSE port
web_port: 8088       # REST API + Web UI port
db: "/data/research.db"  # SQLite path (mounted volume)
log_level: info

# Authentication
auth_enabled: true
allow_registration: true
base_url: "https://mcp.example.com"  # public URL for OAuth metadata
# jwt_secret: "your-secret-here"     # set for persistence across restarts
